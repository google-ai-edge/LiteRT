diff --git a/BUILD b/BUILD
index a517aa16..b5c52ec5 100644
--- a/BUILD
+++ b/BUILD
@@ -1427,9 +1427,9 @@ perfetto_genrule(
     outs = [
         "perfetto_version.gen.h",
     ],
-    cmd = "$(location gen_version_header_py) --cpp_out=$@ --changelog=$(location CHANGELOG)",
+    cmd = "python3 $(location tools/write_version_header.py) --cpp_out=$@ --changelog=$(location CHANGELOG)",
     tools = [
-        ":gen_version_header_py",
+        "tools/write_version_header.py",
     ],
 )

diff --git a/bazel/rules.bzl b/bazel/rules.bzl
index 563382a1..816e1e21 100644
--- a/bazel/rules.bzl
+++ b/bazel/rules.bzl
@@ -15,7 +15,8 @@
 load("@perfetto//bazel:proto_gen.bzl", "proto_descriptor_gen", "proto_gen")
 load("@perfetto//bazel:run_ait_with_adb.bzl", "android_instrumentation_test")
 load("@perfetto_cfg//:perfetto_cfg.bzl", "PERFETTO_CONFIG")
-load("@rules_android//android:rules.bzl", "android_binary", "android_library")
+def android_binary(**kwargs): pass
+def android_library(**kwargs): pass

 # +----------------------------------------------------------------------------+
