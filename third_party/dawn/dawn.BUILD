# Build targets for open-source Dawn repository.

load("@rules_python//python:defs.bzl", "py_binary")
load(":dawn_config.bzl", "DAWN_FROM_SOURCE", "dawn_runtime_deps")

package(default_visibility = ["//visibility:public"])

# When Dawn is built from source, the generated headers are copied from its CMake build (they match
# the built library and Dawn version) instead of being generated by dawn_json_generator.
_CMAKE_CPP_HEADERS = ["dawn/webgpu_cpp.h", "dawn/webgpu_cpp_print.h", "webgpu/webgpu_cpp_chained_struct.h"]

_CMAKE_HEADERS = ["dawn/webgpu.h", "dawn/dawn_proc_table.h", "dawn/dawn_version.h"]

py_binary(
    name = "dawn_json_generator",
    srcs = [
        "generator/dawn_json_generator.py",
        "generator/generator_lib.py",
        "generator/webgpu_docs_utility.py",
    ],
    imports = [
        "generator",
    ],
    # Disable implicit __init__.py creation in runfiles so @jinja2 is not shadowed.
    legacy_create_init = 0,
    deps = [
        "@jinja2",
    ],
)

genrule(
    name = "generate_webgpu_cpp",
    srcs = ["_litert_dawn_build/gen/include/" + h for h in _CMAKE_CPP_HEADERS] if DAWN_FROM_SOURCE else glob([
        "generator/templates/**/*",
    ]) + [
        "src/dawn/dawn.json",
        "src/dawn/dawn_wire.json",
    ],
    outs = [
        "include/dawn/webgpu_cpp.h",
        "include/dawn/webgpu_cpp_print.h",
        "include/webgpu/webgpu_cpp_chained_struct.h",
    ],
    cmd = " && ".join([
        "cp $(location _litert_dawn_build/gen/include/%s) $(RULEDIR)/include/%s" % (h, h)
        for h in _CMAKE_CPP_HEADERS
    ]) if DAWN_FROM_SOURCE else "$(location :dawn_json_generator) " +
          "--dawn-json $(location src/dawn/dawn.json) " +
          "--wire-json $(location src/dawn/dawn_wire.json) " +
          "--template-dir $$(dirname $(location generator/templates/api_cpp.h)) " +
          "--targets cpp_headers " +
          "--output-dir $(RULEDIR)",
    tools = [] if DAWN_FROM_SOURCE else [":dawn_json_generator"],
)

genrule(
    name = "generate_webgpu",
    srcs = ["_litert_dawn_build/gen/include/" + h for h in _CMAKE_HEADERS] if DAWN_FROM_SOURCE else glob([
        "generator/templates/**/*",
    ]) + [
        "src/dawn/dawn.json",
        "src/dawn/dawn_wire.json",
    ],
    outs = [
        "include/dawn/webgpu.h",
        "include/dawn/dawn_proc_table.h",
    ] + (["include/dawn/dawn_version.h"] if DAWN_FROM_SOURCE else []),
    cmd = " && ".join([
        "cp $(location _litert_dawn_build/gen/include/%s) $(RULEDIR)/include/%s" % (h, h)
        for h in _CMAKE_HEADERS
    ]) if DAWN_FROM_SOURCE else "$(location :dawn_json_generator) " +
          "--dawn-json $(location src/dawn/dawn.json) " +
          "--wire-json $(location src/dawn/dawn_wire.json) " +
          "--template-dir $$(dirname $(location generator/templates/api.h)) " +
          "--targets headers " +
          "--output-dir $(RULEDIR)",
    tools = [] if DAWN_FROM_SOURCE else [":dawn_json_generator"],
)

cc_library(
    name = "webgpu_headers",
    hdrs = [
        ":generate_webgpu",
        ":generate_webgpu_cpp",
    ] + glob([
        "include/**/*.h",
        "src/**/*.h",
    ]),
    includes = [
        "include",
        "src",
    ],
    deps = [
        "@com_google_absl//absl/types:span",
    ],
)

cc_library(
    name = "dawn_headers",
    hdrs = [
        ":generate_webgpu",
    ] + glob([
        "include/**/*.h",
    ]),
    includes = [
        "include",
    ],
)

cc_library(
    name = "dawncpp_headers",
    hdrs = [
        ":generate_webgpu_cpp",
    ] + glob([
        "include/**/*.h",
    ]),
    includes = [
        "include",
    ],
    deps = [
        "@com_google_absl//absl/types:span",
    ],
)

cc_library(
    name = "dawn_native",
    hdrs = [
        ":generate_webgpu",
        ":generate_webgpu_cpp",
    ] + glob([
        "include/**/*.h",
        "src/**/*.h",
    ]),
    includes = [
        "include",
        "src",
    ],
    deps = [
        ":webgpu_headers",
    ],
)

genrule(
    name = "generate_webgpu_dawn_stub",
    srcs = ["include/dawn/webgpu.h"],
    outs = ["webgpu_dawn_stub.cc"],
    cmd = "sed -n -E 's/.*WGPU_EXPORT .* (wgpu[A-Za-z0-9_]+)\\(.*/extern \"C\" __declspec(dllexport) void \\1() {}/p' $(location include/dawn/webgpu.h) > $@",
    target_compatible_with = ["@platforms//os:windows"],
)

cc_binary(
    name = "stub/webgpu_dawn.dll",
    srcs = [":webgpu_dawn_stub.cc"],
    linkshared = 1,
    target_compatible_with = ["@platforms//os:windows"],
)

filegroup(
    name = "webgpu_dawn_interface_lib",
    srcs = [":stub/webgpu_dawn.dll"],
    output_group = "interface_library",
    target_compatible_with = ["@platforms//os:windows"],
)

cc_import(
    name = "webgpu_dawn_dll_import",
    interface_library = ":webgpu_dawn_interface_lib",
    system_provided = 1,
    target_compatible_with = ["@platforms//os:windows"],
)

cc_library(
    name = "webgpu_dawn",
    hdrs = [
        ":generate_webgpu",
        ":generate_webgpu_cpp",
    ] + glob([
        "include/**/*.h",
        "src/**/*.h",
    ]),
    includes = [
        "include",
        "src",
    ],
    # Without the Dawn library built from source, Windows delay-loads a separate webgpu_dawn.dll.
    linkopts = [] if DAWN_FROM_SOURCE else select({
        "@platforms//os:windows": [
            "/DELAYLOAD:webgpu_dawn.dll",
            "delayimp.lib",
        ],
        "//conditions:default": [],
    }),
    deps = [
        ":dawn_native",
        ":webgpu_headers",
    ] + dawn_runtime_deps() + ([] if DAWN_FROM_SOURCE else select({
        "@platforms//os:windows": [":webgpu_dawn_dll_import"],
        "//conditions:default": [],
    })),
)

cc_library(
    name = "libdawn_proc",
    hdrs = [
        ":generate_webgpu",
    ] + glob([
        "include/**/*.h",
    ]),
    includes = [
        "include",
    ],
)
