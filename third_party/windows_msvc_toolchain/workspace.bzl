"""Linux-hosted Windows x86_64 MSVC-ABI C++ toolchain using clang-cl + xwin."""

_XWIN_VERSION = "0.10.0"
_XWIN_URL = (
    "https://github.com/Jake-Shadle/xwin/releases/download/{v}/" +
    "xwin-{v}-x86_64-unknown-linux-musl.tar.gz"
).format(v = _XWIN_VERSION)
_XWIN_SHA256 = "d870eb4b2f390878af6da1ccd3cf321d22fcb72720984853b4be732ae597fc88"
_XWIN_STRIP_PREFIX = "xwin-{v}-x86_64-unknown-linux-musl".format(v = _XWIN_VERSION)

# Pinned so the sysroot (and the DLLs built against it) does not change when
# Microsoft publishes a newer MSVC CRT or Windows SDK.
_MSVC_CRT_VERSION = "14.44.17.14"
_WINDOWS_SDK_VERSION = "10.0.26100"

_CLANG_CL_WRAPPER_TEMPLATE = """#!/bin/bash
set -euo pipefail
export LD_LIBRARY_PATH="external/llvm18_linux_x86_64/lib${{LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}}"
exec "external/llvm18_linux_x86_64/bin/clang-cl" \\
  --target={target_triple} \\
  -fms-compatibility-version=19.44 \\
  /D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH \\
  /D_UCRT_DISABLE_CLANG_WARNINGS= \\
  /D_UCRT_RESTORE_CLANG_WARNINGS= \\
  -resource-dir=external/llvm18_linux_x86_64/lib/clang/18 \\
  -Wno-msvc-include \\
  /imsvc external/windows_msvc_sysroot/sysroot/crt/include \\
  /imsvc external/windows_msvc_sysroot/sysroot/sdk/include/ucrt \\
  /imsvc external/windows_msvc_sysroot/sysroot/sdk/include/um \\
  /imsvc external/windows_msvc_sysroot/sysroot/sdk/include/shared \\
  /imsvc external/windows_msvc_sysroot/sysroot/sdk/include/winrt \\
  /imsvc external/windows_msvc_sysroot/sysroot/sdk/include/cppwinrt \\
  "$@"
"""

_WRAPPER_TEMPLATE = """#!/bin/bash
set -euo pipefail
export LD_LIBRARY_PATH="external/llvm18_linux_x86_64/lib${{LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}}"
exec "external/llvm18_linux_x86_64/bin/{tool}" "$@"
"""

_STUB_BUILD = """# Stub BUILD file on non-Linux-x86_64 hosts.
package(default_visibility = ["//visibility:public"])
"""

_BUILD_TEMPLATE = """# Generated by windows_msvc_sysroot_repo.
load("@bazel_tools//tools/cpp:windows_cc_toolchain_config.bzl", "cc_toolchain_config")
load("@rules_cc//cc:defs.bzl", "cc_toolchain")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "empty",
    srcs = [],
)

filegroup(
    name = "wrappers",
    srcs = glob(["wrappers/*.sh"]),
)

filegroup(
    name = "sysroot_headers",
    srcs = glob([
        "sysroot/crt/include/**",
        "sysroot/sdk/include/cppwinrt/**",
        "sysroot/sdk/include/shared/**",
        "sysroot/sdk/include/ucrt/**",
        "sysroot/sdk/include/um/**",
        "sysroot/sdk/include/winrt/**",
    ]),
)

filegroup(
    name = "sysroot_libs_x64",
    srcs = glob([
        "sysroot/crt/lib/x86_64/**",
        "sysroot/sdk/lib/ucrt/x86_64/**",
        "sysroot/sdk/lib/um/x86_64/**",
    ]),
)

filegroup(
    name = "compiler_files",
    srcs = [
        ":sysroot_headers",
        ":wrappers",
        "@llvm18_linux_x86_64//:all",
    ],
)

filegroup(
    name = "linker_files_x64",
    srcs = [
        ":sysroot_libs_x64",
        ":wrappers",
        "@llvm18_linux_x86_64//:all",
    ],
)

filegroup(
    name = "ar_files",
    srcs = [
        ":wrappers",
        "@llvm18_linux_x86_64//:all",
    ],
)

filegroup(
    name = "all_files_x64",
    srcs = [
        ":sysroot_headers",
        ":sysroot_libs_x64",
        ":wrappers",
        "@llvm18_linux_x86_64//:all",
    ],
)

cc_toolchain_config(
    name = "cc_toolchain_config_x64_windows",
    abi_libc_version = "local",
    abi_version = "local",
    archiver_flags = ["/MACHINE:X64"],
    compiler = "clang-cl",
    cpu = "x64_windows",
    cxx_builtin_include_directories = {builtin_include_dirs},
    dbg_mode_debug_flag = "/DEBUG:FULL",
    default_link_flags = [
        "/MACHINE:X64",
        "/LIBPATH:external/windows_msvc_sysroot/sysroot/crt/lib/x86_64",
        "/LIBPATH:external/windows_msvc_sysroot/sysroot/sdk/lib/ucrt/x86_64",
        "/LIBPATH:external/windows_msvc_sysroot/sysroot/sdk/lib/um/x86_64",
        "/DEFAULTLIB:kernel32.lib",
    ],
    fastbuild_mode_debug_flag = "/DEBUG:FASTLINK",
    host_system_name = "x86_64-unknown-linux-gnu",
    msvc_cl_path = "wrappers/clang-cl.sh",
    msvc_env_include = "external/windows_msvc_sysroot/sysroot/crt/include",
    msvc_env_lib = "external/windows_msvc_sysroot/sysroot/crt/lib/x86_64",
    msvc_env_path = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    msvc_env_tmp = "/tmp",
    msvc_lib_path = "wrappers/llvm-lib.sh",
    msvc_link_path = "wrappers/lld-link.sh",
    msvc_ml_path = "wrappers/clang-cl.sh",
    supports_parse_showincludes = True,
    target_libc = "msvcrt",
    target_system_name = "x86_64-pc-windows-msvc",
    tool_paths = {{
        "ar": "wrappers/llvm-lib.sh",
        "cpp": "wrappers/clang-cl.sh",
        "gcc": "wrappers/clang-cl.sh",
        "gcov": "/bin/false",
        "ld": "wrappers/lld-link.sh",
        "ml": "wrappers/clang-cl.sh",
        "nm": "/bin/false",
        "objcopy": "/bin/false",
        "objdump": "/bin/false",
        "strip": "wrappers/llvm-strip.sh",
    }},
    toolchain_identifier = "linux_x86_64_clang_cl_x64_windows",
)

cc_toolchain(
    name = "cc_toolchain_x64_windows",
    all_files = ":all_files_x64",
    ar_files = ":ar_files",
    as_files = ":compiler_files",
    compiler_files = ":compiler_files",
    dwp_files = ":empty",
    linker_files = ":linker_files_x64",
    objcopy_files = ":empty",
    strip_files = ":ar_files",
    supports_param_files = 1,
    toolchain_config = ":cc_toolchain_config_x64_windows",
    toolchain_identifier = "linux_x86_64_clang_cl_x64_windows",
)
"""

def _dedupe(items):
    seen = {}
    out = []
    for item in items:
        if item not in seen:
            seen[item] = True
            out.append(item)
    return out

def _windows_msvc_sysroot_repo_impl(ctx):
    host_os = ctx.os.name.lower()
    host_arch = ctx.os.arch.lower()
    if not host_os.startswith("linux") or host_arch not in ("amd64", "x86_64"):
        ctx.file("BUILD.bazel", _STUB_BUILD)
        return

    ctx.download_and_extract(
        url = _XWIN_URL,
        output = "xwin_bin",
        sha256 = _XWIN_SHA256,
        stripPrefix = _XWIN_STRIP_PREFIX,
    )

    # Place the xwin download/unpack cache inside the repository directory
    # (and pass --copy) so splat never fails with EXDEV across mount points
    # (e.g. when /tmp is tmpfs inside Docker). xwin splat normalizes the
    # architecture subdirectory to x86_64 and adds lowercase/UPPERCASE symlinks
    # for headers and .lib files; we also add TitleCase and original-stem .lib
    # symlinks below (e.g. Shell32.lib, Advapi32.lib, User32.lib) for Windows
    # BUILD linkopts and #pragma comment(lib, ...).
    cache_dir = str(ctx.path(".xwin-cache"))
    sysroot_dir = str(ctx.path("sysroot"))

    # Using --config=cross_compile_windows_x86_64 implies accepting the
    # Microsoft Visual Studio license terms for the MSVC CRT and Windows SDK
    # that xwin downloads.
    res = ctx.execute(
        [
            ctx.path("xwin_bin/xwin"),
            "--accept-license",
            "--manifest-version",
            "17",
            "--channel",
            "release",
            "--crt-version",
            _MSVC_CRT_VERSION,
            "--sdk-version",
            _WINDOWS_SDK_VERSION,
            "--cache-dir",
            cache_dir,
            "--http-retry",
            "5",
            "--arch",
            "x86_64",
            "splat",
            "--copy",
            "--output",
            sysroot_dir,
        ],
        # Downloads and unpacks several hundred MB; Bazel's default is 600s.
        timeout = 3600,
        quiet = False,
    )
    if res.return_code != 0:
        fail("xwin splat failed (exit code {}):\nSTDOUT:\n{}\nSTDERR:\n{}".format(
            res.return_code,
            res.stdout,
            res.stderr,
        ))
    ctx.delete(".xwin-cache")
    ctx.delete("xwin_bin")

    for lib_subdir in (
        "sysroot/crt/lib/x86_64",
        "sysroot/sdk/lib/ucrt/x86_64",
        "sysroot/sdk/lib/um/x86_64",
    ):
        lib_dir = ctx.path(lib_subdir)
        if not lib_dir.exists:
            continue
        entries = lib_dir.readdir()
        existing = {entry.basename: True for entry in entries}
        for entry in entries:
            name = entry.basename
            if not name.lower().endswith(".lib"):
                continue
            stem = name[:-4]
            target = entry.realpath
            for variant in (
                stem + ".lib",
                stem.lower() + ".lib",
                stem.upper() + ".lib",
                stem.capitalize() + ".lib",
            ):
                if variant not in existing:
                    ctx.symlink(target, lib_subdir + "/" + variant)
                    existing[variant] = True

    ctx.file(
        "wrappers/clang-cl.sh",
        _CLANG_CL_WRAPPER_TEMPLATE.format(target_triple = "x86_64-pc-windows-msvc"),
        executable = True,
    )
    for tool_name in ("lld-link", "llvm-lib", "llvm-strip"):
        ctx.file(
            "wrappers/{}.sh".format(tool_name),
            _WRAPPER_TEMPLATE.format(tool = tool_name),
            executable = True,
        )

    repo_dir = ctx.path(".")
    repo_realpath = repo_dir.realpath
    sysroot_path = str(ctx.path("sysroot"))
    sysroot_realpath = str(ctx.path("sysroot").realpath)
    builtin_include_dirs = _dedupe([
        "%package(@windows_msvc_sysroot//)%/sysroot",
        "%package(@llvm18_linux_x86_64//)%/lib/clang/18/include",
        sysroot_path,
        sysroot_realpath,
        str(repo_dir.dirname) + "/llvm18_linux_x86_64/lib/clang/18/include",
        str(repo_realpath.dirname) + "/llvm18_linux_x86_64/lib/clang/18/include",
    ])

    ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(
            builtin_include_dirs = repr(builtin_include_dirs),
        ),
    )

windows_msvc_sysroot_repo = repository_rule(
    implementation = _windows_msvc_sysroot_repo_impl,
)

def windows_msvc_toolchain_configure(name = "windows_msvc_sysroot"):
    """Declares the lazy xwin sysroot repo and registers the cross cc_toolchain.

    Args:
      name: Name of the sysroot repository. Must stay "windows_msvc_sysroot",
        which the generated toolchain and wrappers refer to.
    """
    windows_msvc_sysroot_repo(name = name)
    native.register_toolchains(
        "//third_party/windows_msvc_toolchain:linux_x86_64_windows_x86_64",
    )
