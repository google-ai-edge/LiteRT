# Swift Package Manager checks this repository out from its own local mirror,
# which doesn't have the Git LFS objects for the prebuilt binaries under
# litert/prebuilt/. Without this setting, such checkouts fail with git-lfs
# errors like "remote missing object" (in Xcode, e.g. "unexpectedly did not
# find the new dependency in the package graph"). This repository's Swift
# package doesn't use those binaries, so keep their LFS pointer files instead
# of failing. Clones that can reach the LFS server still download the binaries
# as usual.
[lfs]
	skipdownloaderrors = true
