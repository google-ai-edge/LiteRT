# Raw-token benchmark driver. Copy this file to local_gemma4_benchmark/BUILD
# alongside adapter.cc in the isolated LiteRT-LM checkout before invoking Bazel.
package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "adapter",
    srcs = ["adapter.cc"],
    linkstatic = True,
    linkopts = select({
        "@platforms//os:android": [
            "-Wl,--export-dynamic-symbol=LiteRt*",
            "-lEGL",
            "-lGLESv3",
        ],
        "//conditions:default": [],
    }),
    deps = [
        "//runtime/components:model_resources_litert_lm",
        "//runtime/engine:engine_settings",
        "//runtime/executor:llm_executor_io_types",
        "//runtime/executor:llm_litert_compiled_model_executor_factory",
        "//runtime/executor:llm_processed_context",
        "//runtime/executor:magic_number_configs_helper",
        "//runtime/executor/litert:state",
        "//runtime/util:convert_tensor_buffer",
        "//runtime/util:litert_lm_loader",
        "//runtime/util:scoped_file",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/types:span",
        "@litert//litert/cc:litert_environment",
        "@litert//litert/cc:litert_tensor_buffer",
        "@nlohmann_json//:json",
    ],
)
