"""Type stubs for the `litert_model` pybind11 extension (internal API).

Use `litert_model.py` instead of this module.
"""

from typing import Any

DISPATCH_OP_CUSTOM_CODE: str
DEFAULT_SIGNATURE_KEY: str
BUILD_STAMP_METADATA_KEY: str

class LiteRtError(RuntimeError):
  status: str
  status_code: int
  op: Any

class ShapeInferenceError(LiteRtError): ...
class ValidationError(LiteRtError): ...

def element_type_values() -> dict[str, int]: ...
def op_code_values() -> dict[str, int]: ...
def element_type_bit_width(element_type: int) -> int: ...

class Model:
  @staticmethod
  def load_from_file(path: str) -> Model: ...
  @staticmethod
  def load_from_bytes(data: Any) -> Model: ...
  @staticmethod
  def create() -> Model: ...
  def num_subgraphs(self) -> int: ...
  def subgraph(self, index: int) -> Subgraph: ...
  def subgraphs(self) -> list[Subgraph]: ...
  def add_subgraph(self, name: str) -> Subgraph: ...
  # Removes subgraphs not reachable from any signature (or main subgraph when
  # signatureless), remaps STABLEHLO_COMPOSITE decompositionSubgraphIndex
  # attributes on remaining subgraphs, and returns the count of removed
  # subgraphs (0 if nothing was unreachable or if control-flow operators
  # prevented pruning).
  def prune_unreachable_subgraphs(self) -> int: ...
  def signatures(self) -> list[Signature]: ...
  def find_signature(self, key: str) -> Signature: ...
  def add_signature(
      self,
      key: str,
      subgraph: Subgraph,
      inputs: list[tuple[str, Tensor]],
      outputs: list[tuple[str, Tensor]],
  ) -> Signature: ...
  def remove_signature(self, key: str) -> None: ...
  def metadata_keys(self) -> list[str]: ...
  def metadata(self, key: str) -> bytes | None: ...
  def push_metadata(self, key: str, data: Any) -> None: ...
  def validate(self) -> None: ...
  def serialize(self, bytecode_alignment: int) -> bytes: ...
  def is_serialized(self) -> bool: ...
  def infer_shapes(self, validation_only: bool) -> None: ...
  def specialize_subgraph(
      self, subgraph: Subgraph, input_shapes: list[list[int]]
  ) -> Subgraph: ...
  def register_buffer(self, data: Any) -> int: ...
  def attach_asset(self, op: Op, buffer_id: int, name: str) -> None: ...
  def set_build_stamp(self, soc_manufacturer: str, soc_model: str) -> None: ...
  def build_stamp(self) -> tuple[str, str] | None: ...

class Subgraph:
  def index(self) -> int: ...
  def name(self) -> str: ...
  def set_name(self, name: str) -> None: ...
  def inputs(self) -> list[Tensor]: ...
  def outputs(self) -> list[Tensor]: ...
  def set_inputs(self, inputs: list[Tensor]) -> None: ...
  def set_outputs(self, outputs: list[Tensor]) -> None: ...
  def tensors(self) -> list[Tensor]: ...
  def num_ops(self) -> int: ...
  def ops(self) -> list[Op]: ...
  def add_tensor(
      self, shape: list[int], element_type: int, name: str
  ) -> Tensor: ...
  def add_op(
      self,
      code: int,
      inputs: list[Tensor],
      outputs: list[Tensor],
      index: int | None,
      custom_code: str | None,
      custom_options: bytes | None,
  ) -> Op: ...
  def remove_op(self, op: Op) -> None: ...
  def remove_tensor(self, tensor: Tensor) -> None: ...
  def dce(self) -> bool: ...
  def replace_all_uses(
