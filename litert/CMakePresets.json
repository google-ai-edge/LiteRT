{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (host) Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/cmake_build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-fpermissive",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
      }
    },
    {
      "name": "default-debug",
      "displayName": "Default (host) Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/cmake_build_debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fpermissive",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/cmake_build_android_arm64",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Android",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "26",
        "CMAKE_BUILD_TYPE": "Release",
        "LITERT_AUTO_BUILD_TFLITE": "ON",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
      }
    },
    {
      "name": "android-arm64-debug",
      "displayName": "Android arm64-v8a Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/cmake_build_android_arm64_debug",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Android",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "26",
        "CMAKE_BUILD_TYPE": "Debug",
        "LITERT_AUTO_BUILD_TFLITE": "ON",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
      }
    },
    {
      "name": "linux-aarch64-oe-gcc11.2",
      "displayName": "Linux aarch64 OpenEmbedded (GCC 11.2)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/cmake_build_linux_aarch64_oe_gcc11_2",
      "toolchainFile": "${sourceDir}/vendors/qualcomm/toolchain/linux_aarch64_oe_gcc11_2.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_BUILD_TYPE": "Release",
        "LITERT_ENABLE_GPU": "OFF",
        "TFLITE_ENABLE_GPU": "OFF",
        "LITERT_AUTO_BUILD_TFLITE": "ON",
        "LITERT_HOST_C_COMPILER": "/usr/bin/gcc",
        "LITERT_HOST_CXX_COMPILER": "/usr/bin/g++"
      }
    },
    {
      "name": "custom-toolchain",
      "displayName": "Custom toolchain file",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/cmake_build_custom_toolchain",
      "toolchainFile": "$env{LITERT_TOOLCHAIN_FILE}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LITERT_AUTO_BUILD_TFLITE": "ON"
      }
    }
  ]
}
