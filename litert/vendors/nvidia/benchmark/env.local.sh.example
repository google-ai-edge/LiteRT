# A machine's paths for the NVIDIA benchmarks: copy to env.local.sh (sourced first by env.sh).
# export LITERT_RT_DIR=/path/to/LiteRT
# export LITERT_LM_DIR=/path/to/LiteRT-LM
# export TENSORRT_RTX_ROOT=/path/to/TensorRT-RTX
# export CUDA_HOME=/usr/local/cuda
# export LITERT_BENCH_ROOT=$HOME/.local/state/litert-nvidia-benchmark-wl
# export LITERT_BENCH_MODELS=/path/to/litertlm-files
# The llama.cpp comparison (llama/env.sh):
# export LLAMA_CPP_DIR=$HOME/odml/llama.cpp
# export LLAMA_BIN=$LLAMA_CPP_DIR/build/bin
# export LLAMA_LOCAL_MODELS=/path/to/gguf-files
# export LLAMA_HF_HUB=$HOME/.cache/huggingface/hub
