# Keep Model Converter's VGF operations compatible with the LLVM/MLIR revision
# used by LiteRT. Function-like operations now require symbol visibility and a
# declaration query, and CallInterfaceCallable uses MLIR casting rather than a
# PointerUnion-style get() API.

diff --git a/src/vgf-dialect/VGFOps.td b/src/vgf-dialect/VGFOps.td
index da7f94d..8e92c78 100644
--- a/src/vgf-dialect/VGFOps.td
+++ b/src/vgf-dialect/VGFOps.td
@@ -55,7 +55,7 @@ class VGF_Op<string mnemonic, list<Trait> traits = []> :
 //===----------------------------------------------------------------------===//
 
 def SequenceOp : VGF_Op<"sequence",
-  [InModuleScope, IsolatedFromAbove, SymbolName, SymbolVisibility,
+  [InModuleScope, IsolatedFromAbove,
    FunctionOpInterface, SymbolTable]> {
   let summary = "TODO";
   let description = [{
@@ -79,6 +79,25 @@ def SequenceOp : VGF_Op<"sequence",
 
     /// CallableOpInterface
     Region *getCallableRegion() { return &getBody(); }
+
+    /// SymbolOpInterface
+    StringAttr getNameAttr() {
+      return ::mlir::SymbolTable::getSymbolName(getOperation());
+    }
+
+    void setName(StringAttr name) {
+      getOperation()->setAttr("sym_name", name);
+    }
+
+    ::mlir::SymbolTable::Visibility getVisibility() {
+      return ::mlir::SymbolTable::getSymbolVisibility(getOperation());
+    }
+
+    void setVisibility(::mlir::SymbolTable::Visibility visibility) {
+      ::mlir::SymbolTable::setSymbolVisibility(getOperation(), visibility);
+    }
+
+    bool isDeclaration() { return getBody().empty(); }
   }];
 
   let hasCustomAssemblyFormat = 1;
@@ -105,7 +124,7 @@ def SequenceOutputOp : VGF_Op<"sequence_output",
 //===----------------------------------------------------------------------===//
 
 def SegmentOp : VGF_Op<"segment",
-  [HasParent<"SequenceOp">, IsolatedFromAbove, SymbolName, SymbolVisibility,
+  [HasParent<"SequenceOp">, IsolatedFromAbove,
    FunctionOpInterface, SymbolTable]> {
   let summary = "TODO";
   let description = [{
@@ -130,6 +149,25 @@ def SegmentOp : VGF_Op<"segment",
 
     /// CallableOpInterface
     Region *getCallableRegion() { return &getBody(); }
+
+    /// SymbolOpInterface
+    StringAttr getNameAttr() {
+      return ::mlir::SymbolTable::getSymbolName(getOperation());
+    }
+
+    void setName(StringAttr name) {
+      getOperation()->setAttr("sym_name", name);
+    }
+
+    ::mlir::SymbolTable::Visibility getVisibility() {
+      return ::mlir::SymbolTable::getSymbolVisibility(getOperation());
+    }
+
+    void setVisibility(::mlir::SymbolTable::Visibility visibility) {
+      ::mlir::SymbolTable::setSymbolVisibility(getOperation(), visibility);
+    }
+
+    bool isDeclaration() { return getBody().empty(); }
   }];
 
   let hasCustomAssemblyFormat = 1;
