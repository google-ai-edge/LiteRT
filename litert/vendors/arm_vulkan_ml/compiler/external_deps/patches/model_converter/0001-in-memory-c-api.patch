diff --git a/src/model_converter_c_api.cpp b/src/model_converter_c_api.cpp
new file mode 100644
index 0000000..e8eca97
--- /dev/null
+++ b/src/model_converter_c_api.cpp
@@ -0,0 +1,115 @@
+#include "model_converter/model_converter.h"
+
+#include "compiler.hpp"
+
+#include <cstddef>
+#include <cstdint>
+#include <exception>
+#include <ostream>
+#include <streambuf>
+#include <vector>
+
+namespace {
+
+constexpr uint32_t kKnownOptionFlags = MC_OPTION_EMIT_DEBUG_INFO | MC_OPTION_DUMP_MLIR;
+
+class VectorStreamBuffer final : public std::streambuf {
+  public:
+    const std::vector<char> &data() const { return data_; }
+
+  protected:
+    std::streamsize xsputn(const char *data, std::streamsize size) override {
+        if (size <= 0) {
+            return 0;
+        }
+        const auto count = static_cast<size_t>(size);
+        if (count > data_.max_size() - data_.size()) {
+            return 0;
+        }
+        data_.insert(data_.end(), data, data + count);
+        return size;
+    }
+
+    int_type overflow(int_type character) override {
+        if (traits_type::eq_int_type(character, traits_type::eof())) {
+            return traits_type::not_eof(character);
+        }
+        data_.push_back(traits_type::to_char_type(character));
+        return character;
+    }
+
+  private:
+    std::vector<char> data_;
+};
+
+mc_status ConfigureCompilerOptions(const mc_options *options, mlsdk::model_converter::Compiler::Options &result) {
+    result.enable_verifier = true;
+    if (options == nullptr) {
+        return MC_STATUS_OK;
+    }
+    if (options->struct_size < sizeof(mc_options) || options->abi_version != MC_OPTIONS_ABI_VERSION ||
+        (options->flags & ~kKnownOptionFlags) != 0) {
+        return MC_STATUS_UNSUPPORTED_OPTIONS;
+    }
+
+    result.emit_debug_info = (options->flags & MC_OPTION_EMIT_DEBUG_INFO) != 0;
+    result.dump_mlir = (options->flags & MC_OPTION_DUMP_MLIR) != 0;
+    return MC_STATUS_OK;
+}
+
+} // namespace
+
+extern "C" mc_status mc_convert_tosa_to_vgf(const void *tosa_data, size_t tosa_size, const mc_options *options,
+                                            mc_output_callback output, void *user_data) {
+    if (tosa_data == nullptr || tosa_size == 0 || output == nullptr) {
+        return MC_STATUS_INVALID_ARGUMENT;
+    }
+
+    try {
+        mlsdk::model_converter::Compiler::Options compilerOptions;
+        const mc_status optionStatus = ConfigureCompilerOptions(options, compilerOptions);
+        if (optionStatus != MC_STATUS_OK) {
+            return optionStatus;
+        }
+
+        VectorStreamBuffer outputBuffer;
+        std::ostream outputStream(&outputBuffer);
+        compilerOptions.output_stream = &outputStream;
+
+        mlsdk::model_converter::Compiler compiler(compilerOptions);
+        compiler.SetLogging();
+        compiler.SetRegistry();
+        compiler.SetMultiThreading(false);
+        compiler.SetPassManager();
+        if (!compiler.CompileBuffer(tosa_data, tosa_size) || !outputStream.good() || outputBuffer.data().empty()) {
+            return MC_STATUS_COMPILATION_ERROR;
+        }
+
+        if (output(outputBuffer.data().data(), outputBuffer.data().size(), user_data) != 0) {
+            return MC_STATUS_WRITE_ERROR;
+        }
+        return MC_STATUS_OK;
+    } catch (const std::exception &) {
+        return MC_STATUS_INTERNAL_ERROR;
+    } catch (...) {
+        return MC_STATUS_INTERNAL_ERROR;
+    }
+}
+
+extern "C" const char *mc_status_message(mc_status status) {
+    switch (status) {
+    case MC_STATUS_OK:
+        return "success";
+    case MC_STATUS_INVALID_ARGUMENT:
+        return "invalid argument";
+    case MC_STATUS_UNSUPPORTED_OPTIONS:
+        return "unsupported options";
+    case MC_STATUS_COMPILATION_ERROR:
+        return "could not compile TOSA MLIR to VGF";
+    case MC_STATUS_WRITE_ERROR:
+        return "output callback failed";
+    case MC_STATUS_INTERNAL_ERROR:
+        return "internal error";
+    }
+    return "unknown status";
+}
