 }
 
+bool Compiler::CompileBuffer(const void *input_data, size_t input_size) {
+    if (input_data == nullptr || input_size == 0) {
+        return false;
+    }
+
+    mlir::ParserConfig config(&_context);
+    llvm::StringRef input(static_cast<const char *>(input_data), input_size);
+    OwningOpRef<ModuleOp> moduleOp = mlir::parseSourceString<ModuleOp>(input, config, "mc-input");
+    if (!moduleOp) {
+        return false;
+    }
+
+    return mlir::succeeded(_pm.run(*moduleOp));
+}
+
 } // namespace mlsdk::model_converter
