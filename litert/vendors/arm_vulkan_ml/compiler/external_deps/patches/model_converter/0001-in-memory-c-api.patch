--- /dev/null
+++ b/include/model_converter/model_converter.h
@@ -0,0 +1,59 @@
+#ifndef MODEL_CONVERTER_MODEL_CONVERTER_H_
+#define MODEL_CONVERTER_MODEL_CONVERTER_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define MC_API __attribute__((visibility("default")))
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define MC_OPTIONS_ABI_VERSION 1u
+
+typedef enum mc_status {
+    MC_STATUS_OK = 0,
+    MC_STATUS_INVALID_ARGUMENT = 1,
+    MC_STATUS_UNSUPPORTED_OPTIONS = 2,
+    MC_STATUS_COMPILATION_ERROR = 3,
+    MC_STATUS_WRITE_ERROR = 4,
+    MC_STATUS_INTERNAL_ERROR = 5,
+} mc_status;
+
+typedef enum mc_option_flags {
+    MC_OPTION_EMIT_DEBUG_INFO = 1u << 0,
+    MC_OPTION_DUMP_MLIR = 1u << 1,
+} mc_option_flags;
+
+// Versioned, fixed-width options for the C ABI. Initialize with
+// MC_OPTIONS_INIT, then set flags as required.
+typedef struct mc_options {
+    uint32_t struct_size;
+    uint32_t abi_version;
+    uint32_t flags;
+} mc_options;
+
+#define MC_OPTIONS_INIT \
+    { sizeof(mc_options), MC_OPTIONS_ABI_VERSION, 0u }
+
+// Receives the complete VGF result. The data remains valid only for the
+// duration of the callback. Return zero on success and nonzero to make
+// mc_convert_tosa_to_vgf() return MC_STATUS_WRITE_ERROR.
+typedef int (*mc_output_callback)(const void *data, size_t size, void *user_data);
+
+// Converts textual or bytecode TOSA MLIR held in memory to VGF held in memory.
+// This function performs no file I/O and never throws across the C boundary.
+// A null options pointer selects the same default conversion behavior as the
+// command-line driver.
+MC_API mc_status mc_convert_tosa_to_vgf(const void *tosa_data, size_t tosa_size, const mc_options *options,
+                                        mc_output_callback output, void *user_data);
+
+// Returns a static, null-terminated description of a status code.
+MC_API const char *mc_status_message(mc_status status);
+
+#ifdef __cplusplus
+} // extern "C"
+#endif
+
+#endif // MODEL_CONVERTER_MODEL_CONVERTER_H_
