+Value leftPadConstantShape(PatternRewriter& rewriter, Location loc,
+                           Value value, int64_t target_rank) {
+  auto type = dyn_cast<RankedTensorType>(value.getType());
+  if (!type || !type.hasStaticShape() || type.getRank() >= target_rank) {
+    return value;
+  }
+
+  const int64_t rank_delta = target_rank - type.getRank();
+  Type element_type = type.getElementType();
+  if (auto per_axis =
+          dyn_cast<quant::UniformQuantizedPerAxisType>(element_type)) {
+    element_type = quant::UniformQuantizedPerAxisType::get(
+        per_axis.getFlags(), per_axis.getStorageType(),
+        per_axis.getExpressedType(), per_axis.getScales(),
+        per_axis.getZeroPoints(),
+        per_axis.getQuantizedDimension() + rank_delta,
+        per_axis.getStorageTypeMin(), per_axis.getStorageTypeMax());
+  }
+
+  DenseElementsAttr attr;
+  if (!matchPattern(value, m_Constant(&attr))) {
+    return value;
+  }
+
+  SmallVector<int64_t> shape(rank_delta, 1);
+  shape.append(type.getShape().begin(), type.getShape().end());
+  auto output_type =
+      tensorflow::GetTypeFromTFTensorShape(shape, element_type);
+
+  Type storage_element_type = element_type;
+  if (auto quantized_type =
+          dyn_cast<quant::QuantizedType>(storage_element_type)) {
+    storage_element_type =
+        tosa::getStorageElementTypeFromQuantized(quantized_type);
+  }
+  auto storage_type =
+      tensorflow::GetTypeFromTFTensorShape(shape, storage_element_type);
+  return rewriter
+      .create<tosa::ConstOp>(loc, output_type, attr.reshape(storage_type))
+      .getResult();
+}
