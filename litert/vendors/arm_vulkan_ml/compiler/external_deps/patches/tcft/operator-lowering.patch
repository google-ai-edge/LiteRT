+static std::optional<int64_t> getConstantScalarInteger(Value value) {
+  auto shaped_type = dyn_cast<ShapedType>(value.getType());
+  if (!shaped_type || !shaped_type.hasRank() ||
+      !shaped_type.hasStaticShape() || shaped_type.getNumElements() != 1) {
+    return std::nullopt;
+  }
+
+  Operation* defining_op = value.getDefiningOp();
+  if (!defining_op || defining_op->getNumOperands() != 0) {
+    return std::nullopt;
+  }
+
+  // Quantized TFL constants cannot be read with m_Constant. During greedy
+  // legalization the producer may still be a TFL constant (whose payload is
+  // named "value") or may already be a tosa.const ("values").
+  ElementsAttr elements = defining_op->getAttrOfType<ElementsAttr>("value");
+  if (!elements) {
+    elements = defining_op->getAttrOfType<ElementsAttr>("values");
+  }
+  if (!elements || elements.getNumElements() != 1 ||
+      !elements.getElementType().isIntOrIndex()) {
+    return std::nullopt;
+  }
+
+  return (*elements.getValues<APInt>().begin()).getSExtValue();
+}
+
+static bool isConstantIntegerTensor(Value value) {
+  Operation* defining_op = value.getDefiningOp();
+  if (!defining_op || defining_op->getNumOperands() != 0) return false;
+
+  ElementsAttr elements = defining_op->getAttrOfType<ElementsAttr>("value");
+  if (!elements) {
+    elements = defining_op->getAttrOfType<ElementsAttr>("values");
+  }
+  return elements && elements.getElementType().isIntOrIndex();
+}
