+struct ShiftedMulScale {
+  int32_t multiplier;
+  int8_t shift;
+};
+
+// Preserve INT16 constant-MUL precision: use TOSA MUL's rounded shift with a
+// signed 31-bit coefficient, then narrow with a saturating scale-one rescale.
+// This retains more coefficient precision than scaling both operands to i32.
+static std::optional<ShiftedMulScale> prepareShiftedMulScale(double scale) {
+  if (!std::isfinite(scale) || scale <= 0.0) return std::nullopt;
+
+  int exponent = 0;
+  const long double mantissa =
+      std::frexp(static_cast<long double>(scale), &exponent);
+  constexpr int kCoefficientBits = 31;
+  long double rounded = std::round(std::ldexp(mantissa, kCoefficientBits));
+  if (rounded == std::ldexp(1.0L, kCoefficientBits)) {
+    rounded /= 2.0L;
+    ++exponent;
+  }
+  const int shift = kCoefficientBits - exponent;
+  if (rounded <= 0.0L || rounded > std::numeric_limits<int32_t>::max() ||
+      shift <= 0 || shift > 63) {
+    return std::nullopt;
+  }
+  return ShiftedMulScale{static_cast<int32_t>(rounded),
+                         static_cast<int8_t>(shift)};
+}
