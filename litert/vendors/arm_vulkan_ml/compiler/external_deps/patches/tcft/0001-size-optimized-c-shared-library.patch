diff --git a/tosa_converter_for_tflite/tcft.cc b/tosa_converter_for_tflite/tcft.cc
new file mode 100644
index 0000000..90c02ca
--- /dev/null
+++ b/tosa_converter_for_tflite/tcft.cc
@@ -0,0 +1,103 @@
+#include "tosa_converter_for_tflite/tcft.h"
+
+#if defined(TCFT_ENABLE_FLATBUFFER)
+#include <string_view>
+#endif
+
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/Support/raw_ostream.h"
+#include "mlir/Bytecode/BytecodeWriter.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/Quant/IR/Quant.h"
+#include "mlir/Dialect/Tensor/IR/Tensor.h"
+#include "mlir/Dialect/Tosa/IR/TosaOps.h"
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/IR/DialectRegistry.h"
+#include "mlir/IR/Location.h"
+#include "mlir/IR/MLIRContext.h"
+#include "mlir/IR/OwningOpRef.h"
+#include "mlir/Pass/PassManager.h"
+#include "mlir/Transforms/Passes.h"
+#if defined(TCFT_ENABLE_FLATBUFFER)
+#include "tflite/converter/flatbuffer_import.h"
+#endif
+#include "tflite/converter/ir/tfl_ops.h"
+#include "tosa_converter_for_tflite/tfl_passes/tfl_passes.h"
+#include "tosa_converter_for_tflite/tfl_passes/transforms/passes.h"
+
+namespace {
+
+tcft_status LegalizeAndWrite(mlir::ModuleOp module, tcft_output_callback output,
+                             void* user_data) {
+  mlir::PassManager pm(module.getContext(), module.getOperationName(),
+                       mlir::OpPassManager::Nesting::Implicit);
+  mlir::tosa::TOSATFLLegalizationPipelineOptions options;
+  mlir::tosa::createTFLtoTOSALegalizationPipeline(pm, options);
+  pm.nest<mlir::func::FuncOp>().addPass(
+      mlir::tosa::createStripQuantTypesPass());
+  pm.addPass(mlir::createStripDebugInfoPass());
+  if (mlir::failed(pm.run(module))) {
+    return TCFT_STATUS_LEGALIZATION_ERROR;
+  }
+
+  llvm::SmallVector<char, 0> output_bytes;
+  llvm::raw_svector_ostream output_stream(output_bytes);
+  if (mlir::failed(mlir::writeBytecodeToFile(module, output_stream))) {
+    return TCFT_STATUS_WRITE_ERROR;
+  }
+  if (output(output_bytes.data(), output_bytes.size(), user_data) != 0) {
+    return TCFT_STATUS_WRITE_ERROR;
+  }
+  return TCFT_STATUS_OK;
+}
+
+#if defined(TCFT_ENABLE_FLATBUFFER)
+tcft_status ConvertFlatBuffer(const void* input_data, size_t input_size,
+                              tcft_output_callback output, void* user_data) {
+  if (input_data == nullptr || output == nullptr) {
+    return TCFT_STATUS_INVALID_ARGUMENT;
+  }
+
+  mlir::MLIRContext context;
+  const mlir::Location source_location =
+      mlir::FileLineColLoc::get(&context, "tcft-input.tflite", 0, 0);
+  mlir::OwningOpRef<mlir::ModuleOp> module = tflite::FlatBufferToMlir(
+      std::string_view(static_cast<const char*>(input_data), input_size),
+      &context, source_location, /*use_external_constant=*/false,
+      /*ordered_input_arrays=*/{}, /*ordered_output_arrays=*/{},
+      /*experimental_prune_unreachable_nodes_unconditionally=*/false,
+      /*disable_vhlo_to_stablehlo=*/true);
+  if (!module) {
+    return TCFT_STATUS_PARSE_ERROR;
+  }
+  return LegalizeAndWrite(*module, output, user_data);
+}
+#endif
+
+}  // namespace
+
+#if defined(TCFT_ENABLE_FLATBUFFER)
+extern "C" tcft_status tcft_convert_tflite_to_tosa(const void* input_data,
+                                                   size_t input_size,
+                                                   tcft_output_callback output,
+                                                   void* user_data) {
+  return ConvertFlatBuffer(input_data, input_size, output, user_data);
+}
+#endif
+
+extern "C" const char* tcft_status_message(tcft_status status) {
+  switch (status) {
+    case TCFT_STATUS_OK:
+      return "success";
+    case TCFT_STATUS_INVALID_ARGUMENT:
+      return "invalid argument";
+    case TCFT_STATUS_PARSE_ERROR:
+      return "could not parse input";
+    case TCFT_STATUS_LEGALIZATION_ERROR:
+      return "could not legalize TFL MLIR to TOSA";
+    case TCFT_STATUS_WRITE_ERROR:
+      return "could not write TOSA MLIR bytecode";
+  }
+  return "unknown status";
+}
diff --git a/tosa_converter_for_tflite/tcft.h b/tosa_converter_for_tflite/tcft.h
new file mode 100644
index 0000000..5c80c21
--- /dev/null
+++ b/tosa_converter_for_tflite/tcft.h
@@ -0,0 +1,45 @@
+#ifndef TOSA_CONVERTER_FOR_TFLITE_TCFT_H_
+#define TOSA_CONVERTER_FOR_TFLITE_TCFT_H_
+
+#include <stddef.h>
+
+#if defined(_WIN32)
+#define TCFT_API __declspec(dllexport)
+#else
+#define TCFT_API __attribute__((visibility("default")))
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Status returned by tcft_convert_tflite_to_tosa().
+typedef enum tcft_status {
+  TCFT_STATUS_OK = 0,
+  TCFT_STATUS_INVALID_ARGUMENT = 1,
+  TCFT_STATUS_PARSE_ERROR = 2,
+  TCFT_STATUS_LEGALIZATION_ERROR = 3,
+  TCFT_STATUS_WRITE_ERROR = 4,
+} tcft_status;
+
+// Receives the complete TOSA MLIR bytecode result. The data remains valid only
+// for the duration of the callback. Return zero on success and nonzero to make
+// tcft_convert_tflite_to_tosa() return TCFT_STATUS_WRITE_ERROR.
+typedef int (*tcft_output_callback)(const void* data, size_t size,
+                                    void* user_data);
+
+// Converts a TFLite FlatBuffer held in memory to TOSA MLIR bytecode. This
+// symbol is exported only by a FlatBuffer-enabled build of the library.
+TCFT_API tcft_status tcft_convert_tflite_to_tosa(const void* input_data,
+                                                 size_t input_size,
+                                                 tcft_output_callback output,
+                                                 void* user_data);
+
+// Returns a static, null-terminated description of a status code.
+TCFT_API const char* tcft_status_message(tcft_status status);
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif  // TOSA_CONVERTER_FOR_TFLITE_TCFT_H_
