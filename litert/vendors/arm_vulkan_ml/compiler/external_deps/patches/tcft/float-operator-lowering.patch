+struct ConvertTFLStaticCumsumOp : public RewritePattern {
+  explicit ConvertTFLStaticCumsumOp(MLIRContext* context)
+      : RewritePattern("tfl.cumsum", 2, context) {}
+
+  LogicalResult matchAndRewrite(Operation* op,
+                                PatternRewriter& rewriter) const override {
+    if (op->getNumOperands() != 2 || op->getNumResults() != 1) return failure();
+    if (auto exclusive = op->getAttrOfType<BoolAttr>("exclusive");
+        exclusive && exclusive.getValue()) {
+      return failure();
+    }
+    if (auto reverse = op->getAttrOfType<BoolAttr>("reverse");
+        reverse && reverse.getValue()) {
+      return failure();
+    }
+    Value input = op->getOperand(0);
+    auto input_type = dyn_cast<RankedTensorType>(input.getType());
+    auto output_type = dyn_cast<RankedTensorType>(op->getResult(0).getType());
+    if (!input_type || !output_type || !input_type.hasStaticShape() ||
+        input_type != output_type ||
+        (!input_type.getElementType().isF32() &&
+         !input_type.getElementType().isInteger(32))) {
+      return failure();
+    }
+    ElementsAttr axis_elements;
+    if (!matchPattern(op->getOperand(1), m_Constant(&axis_elements))) {
+      if (Operation* defining_op = op->getOperand(1).getDefiningOp()) {
+        axis_elements = defining_op->getAttrOfType<ElementsAttr>("value");
+        if (!axis_elements) {
+          axis_elements =
+              defining_op->getAttrOfType<ElementsAttr>("values");
+        }
+      }
+    }
+    if (!axis_elements || axis_elements.getNumElements() != 1) {
+      return failure();
+    }
+    int64_t axis = (*axis_elements.getValues<APInt>().begin()).getSExtValue();
+    if (axis < 0) axis += input_type.getRank();
+    if (axis < 0 || axis >= input_type.getRank()) return failure();
+    constexpr int64_t kMaxExpandedAxisExtent = 64;
+    int64_t axis_extent = input_type.getDimSize(axis);
+    if (axis_extent <= 0 || axis_extent > kMaxExpandedAxisExtent) {
+      return failure();
+    }
+
+    SmallVector<int64_t> slice_shape(input_type.getShape());
+    slice_shape[axis] = 1;
+    auto slice_type = RankedTensorType::get(
+        slice_shape, input_type.getElementType());
+    Value slice_size =
+        getTosaConstShape(rewriter, op->getLoc(), slice_shape);
+    SmallVector<Value> prefixes;
+    prefixes.reserve(axis_extent);
+    Value prefix;
+    for (int64_t index = 0; index < axis_extent; ++index) {
+      SmallVector<int64_t> start(input_type.getRank(), 0);
+      start[axis] = index;
+      Value current = CreateOpAndInfer<tosa::SliceOp>(
+                          rewriter, op->getLoc(), slice_type, input,
+                          getTosaConstShape(rewriter, op->getLoc(), start),
+                          slice_size)
+                          .getResult();
+      if (prefix) {
+        prefix = CreateOpAndInfer<tosa::AddOp>(
+                     rewriter, op->getLoc(), slice_type, prefix, current)
+                     .getResult();
+      } else {
+        prefix = current;
+      }
+      prefixes.push_back(prefix);
+    }
+    CreateReplaceOpAndInfer<tosa::ConcatOp>(
+        rewriter, op, output_type, prefixes,
+        rewriter.getI32IntegerAttr(static_cast<int32_t>(axis)));
+    return success();
+  }
+};
