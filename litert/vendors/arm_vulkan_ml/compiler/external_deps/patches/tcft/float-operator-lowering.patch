@@ -160,6 +165,56 @@ tcft_status ConvertFlatBuffer(const void* input_data, size_t input_size,
     return TCFT_STATUS_INVALID_ARGUMENT;
   }
 
+  // TFLite ignores quantization metadata on floating-point tensors. The
+  // importer instead treats constants with zero points as integer storage,
+  // reinterpreting float bits before dequantizing them. Strip that metadata
+  // before import, leaving real integer quantization unchanged.
+  flatbuffers::Verifier verifier(static_cast<const uint8_t*>(input_data),
+                                 input_size);
+  if (!tflite::VerifyModelBuffer(verifier)) return TCFT_STATUS_PARSE_ERROR;
+  const auto* model = tflite::GetModel(input_data);
+  const auto is_float = [](tflite::TensorType type) {
+    return type == tflite::TensorType_FLOAT16 ||
+           type == tflite::TensorType_FLOAT32 ||
+           type == tflite::TensorType_FLOAT64;
+  };
+  bool has_float_quantization_metadata = false;
+  if (model->subgraphs()) {
+    for (const auto* subgraph : *model->subgraphs()) {
+      if (!subgraph->tensors()) continue;
+      for (const auto* tensor : *subgraph->tensors()) {
+        has_float_quantization_metadata |=
+            is_float(tensor->type()) && tensor->quantization() != nullptr;
+      }
+    }
+  }
+  flatbuffers::FlatBufferBuilder normalized;
+  if (has_float_quantization_metadata) {
+    std::unique_ptr<tflite::ModelT> unpacked(model->UnPack());
+    for (auto& subgraph : unpacked->subgraphs) {
+      for (auto& tensor : subgraph->tensors) {
+        if (is_float(tensor->type)) tensor->quantization.reset();
+      }
+    }
+    // Repacking changes file offsets. Materialize any external buffer data
+    // first, including integer constants that do not need normalization.
+    for (auto& buffer : unpacked->buffers) {
+      if (buffer->offset <= 1) continue;
+      if (buffer->offset > input_size ||
+          buffer->size > input_size - buffer->offset) {
+        return TCFT_STATUS_PARSE_ERROR;
+      }
+      const auto* begin = static_cast<const uint8_t*>(input_data) + buffer->offset;
+      buffer->data.assign(begin, begin + buffer->size);
+      buffer->offset = 0;
+      buffer->size = 0;
+    }
+    tflite::FinishModelBuffer(normalized,
+                             tflite::Model::Pack(normalized, unpacked.get()));
+    input_data = normalized.GetBufferPointer();
+    input_size = normalized.GetSize();
+  }
+
   mlir::MLIRContext context;
   const mlir::Location source_location =
       mlir::FileLineColLoc::get(&context, "tcft-input.tflite", 0, 0);
