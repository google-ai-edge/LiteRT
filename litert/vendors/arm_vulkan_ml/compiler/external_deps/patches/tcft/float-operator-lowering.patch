+LogicalResult ConvertTFLEmbeddingLookupOp::matchAndRewrite(
+    Operation* op, PatternRewriter& rewriter) const {
+  auto embedding_lookup_op = cast<TFL::EmbeddingLookupOp>(op);
+
+  std::optional<Value> result = convertGatherOp(
+      rewriter, op, embedding_lookup_op.getValue(),
+      embedding_lookup_op.getLookup(), /*batch_dims=*/0, /*axis=*/0);
+  if (!result) return failure();
+
+  rewriter.replaceOp(op, {result.value()});
+  return success();
