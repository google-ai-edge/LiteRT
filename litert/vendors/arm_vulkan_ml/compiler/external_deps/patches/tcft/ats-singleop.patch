+mlir::LogicalResult ConvertRankZeroResultsToRankOne(mlir::ModuleOp module) {
+  for (mlir::func::FuncOp function : module.getOps<mlir::func::FuncOp>()) {
+    if (function.empty()) continue;
+    auto return_op =
+        mlir::dyn_cast<mlir::func::ReturnOp>(function.front().getTerminator());
+    if (!return_op) continue;
+
+    llvm::SmallVector<mlir::Type> result_types(
+        function.getFunctionType().getResults());
+    bool changed = false;
+    for (auto [index, original_operand] :
+         llvm::enumerate(return_op.getOperands())) {
+      mlir::Value operand = original_operand;
+      auto type = mlir::dyn_cast<mlir::RankedTensorType>(operand.getType());
+      if (!type) continue;
+
+      mlir::ImplicitLocOpBuilder builder(return_op.getLoc(), return_op);
+      builder.setInsertionPoint(return_op);
+      if (type.getRank() == 0) {
+        auto rank_one_type =
+            mlir::RankedTensorType::get({1}, type.getElementType());
+        mlir::Value shape = mlir::tosa::getTosaConstShape(builder, {1});
+        operand = mlir::tosa::ReshapeOp::create(builder, rank_one_type,
+                                                 operand, shape);
+        return_op.setOperand(index, operand);
+        result_types[index] = rank_one_type;
+        type = rank_one_type;
+        changed = true;
+      }
+
+      if (operand.getDefiningOp<mlir::tosa::ConstOp>()) {
+        mlir::Value identity =
+            mlir::tosa::IdentityOp::create(builder, type, operand);
+        return_op.setOperand(index, identity);
+      }
+    }
+    if (changed) {
+      function.setType(mlir::FunctionType::get(
+          module.getContext(), function.getFunctionType().getInputs(),
+          result_types));
+    }
+  }
+  return mlir::verify(module);
+}
